{
  "manifest_version": 3,
  "name": "PR Focus",
  "version": "0.2.0",
  "minimum_chrome_version": "105",
  "description": "Hides bot and draft pull requests on GitHub PR lists so the ones that need you stand out, and links each PR to its Linear issue.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/rules.js", "src/github.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "PR Focus",
    "default_popup": "src/options.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  }
}
